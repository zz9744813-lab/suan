# NovelForge 2.0 backend env (copy to backend/.env and edit)
APP_NAME=NovelForge 2.0
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/novelforge.db

# API key (header X-API-Key). In dev the default works.
NOVELFORGE_API_KEY=novelforge-local-dev-key

# CORS — Vite dev server
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
