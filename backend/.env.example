# NovelForge 2.0 backend env (copy to backend/.env and edit)
APP_NAME=NovelForge 2.0
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database
# 阶段 3.1 起推荐 PostgreSQL.
# 本地 docker compose 启动后用这个:
#   DATABASE_URL=postgresql+asyncpg://novelforge:novelforge@127.0.0.1:5432/novelforge
# 想继续用 SQLite 回归, 用:
#   DATABASE_URL=sqlite+aiosqlite:///./data/novelforge.db
DATABASE_URL=postgresql+asyncpg://novelforge:novelforge@127.0.0.1:5432/novelforge

# API key (header X-API-Key). In dev the default works.
NOVELFORGE_API_KEY=novelforge-local-dev-key

# CORS — Vite dev server
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- 阶段 3.1: Redis 队列 ----
# 默认连本地 docker compose 的 redis. 改 IP/端口要同步 docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6379/0

# Worker 进程并发
WORKER_CONCURRENCY=4
WORKER_MAX_JOBS=8

# 任务在队列里的默认存活时间 (秒)
TASK_DEFAULT_TTL_SECONDS=3600
# 单任务最大重试次数
TASK_MAX_RETRIES=3

# 阶段 3.1 兼容开关: API 进程内是否继续跑 in-process Worker.
# 3.3 之前默认 true, 避免改动影响验收.
# 切到独立 Worker 进程后, 在 docker-compose 的 backend-api 里设 false.
WORKER_RUN_IN_PROCESS=true
