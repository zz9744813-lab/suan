# ============================================================
# 玄鉴 XuanMirror 环境变量模板
# 复制为 .env 后填写。.env 已在 .gitignore 中，绝不入库。
# ============================================================

# ---------- 应用 ----------
XUANMIRROR_ENV=dev
XUANMIRROR_DEBUG=true
# SQLite 路径（V1）；V2 迁移 PostgreSQL
XUANMIRROR_DB_URL=sqlite:///./data/xuanmirror.db
XUANMIRROR_TIMEZONE=Asia/Shanghai

# ---------- LLM Provider（方案第 41 节 / 第 42 节模型分层）----------
# 规则计算：程序，无 LLM
# Signal Formatting / Outcome Parsing：cheap
# Specialist Interpretation：中高模型
# Fusion / Adversarial Review / Monthly Audit：强推理模型

REASONING_BASE_URL=
REASONING_API_KEY=
REASONING_MODEL=

CHEAP_BASE_URL=
CHEAP_API_KEY=
CHEAP_MODEL=

VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ---------- 调度（方案第 58 节）----------
# 默认 23:30 更新 Reality State → 23:55 冻结明日预测
SCHEDULER_ENABLED=false
SCHEDULER_REALITY_UPDATE=23:30
SCHEDULER_FUTURE_SCAN=23:40
SCHEDULER_METAPHYSICAL=23:45
SCHEDULER_AGENT_REVIEW=23:50
SCHEDULER_FREEZE=23:55

# ---------- 预测预算（方案第 4 节）----------
BUDGET_TOMORROW_STRONG=5
BUDGET_TOMORROW_WATCH=5
BUDGET_7D=5
BUDGET_30D=5
BUDGET_90D=3

# ---------- 隐私（方案第 64 节）----------
# 关闭后所有 Vision 能力降级为不可用，掌纹/面相 Signal 返回空
ENABLE_CLOUD_VISION=false
# 上传 LLM 前强制裁剪原始照片
PRE_UPLOAD_CROP=true

# ---------- 实验模式（方案第 34 / 35 节）----------
# blind_ab: 双盲对照 | hidden: 隐藏预测防自我实现 | 空=正常模式
EXPERIMENT_MODE=
