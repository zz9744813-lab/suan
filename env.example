# Sample env for docker compose. Copy to .env and edit before `docker compose up`.
#
# - NOVELFORGE_API_KEY: the header X-API-Key the frontend must send. Pick
#   something long & random in production.
# - DATABASE_URL:    swap to postgresql+psycopg://... if you grow beyond
#                    a single author. SQLite is fine for a personal
#                    workbench.
# - CORS_ORIGINS:    JSON-encoded list of origins allowed to call the API.
#                    Match the public host you'll reach the UI on.
# - FRONTEND_PORT:   host port for nginx (container always listens on 80).

NOVELFORGE_API_KEY=change-me-in-production-please
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:////app/backend/data/novelforge.db
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
FRONTEND_PORT=8080
